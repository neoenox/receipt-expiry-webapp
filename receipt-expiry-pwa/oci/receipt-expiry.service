[Unit]
Description=Receipt Expiry PWA API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/receipt-expiry
EnvironmentFile=/etc/receipt-expiry.env
ExecStart=/usr/bin/node /opt/receipt-expiry/oci/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
